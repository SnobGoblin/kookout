    "Good hours are judged on the numbers as shown, so changing units can shift a borderline hour.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gode timer vurderes på tallene, som de vises, så skift af enhed kan flytte en time på grænsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gute Stunden werden nach den angezeigten Zahlen bewertet; ein Wechsel der Einheit kann eine Grenzstunde verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las buenas horas se juzgan con los números mostrados, así que cambiar de unidad puede mover una hora límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bonnes heures sont jugées sur les chiffres affichés : changer d'unité peut faire basculer une heure limite."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gode timer vurderes på tallene slik de vises, så bytte av enhet kan flytte en time som ligger på grensen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bra timmar bedöms på siffrorna som de visas, så byte av enhet kan flytta en timme på gränsen."
          }
        }
      }
    },
