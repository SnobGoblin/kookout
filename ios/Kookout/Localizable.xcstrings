    "Apple didn't send what Kookout needs. Try again.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sendte ikke det Kookout trenger. Prøv igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple skickade inte det Kookout behöver. Försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sendte ikke det, Kookout skal bruge. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat nicht gesendet, was Kookout braucht. Versuch es noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n'a pas envoyé ce dont Kookout a besoin. Réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no envió lo que Kookout necesita. Inténtalo de nuevo."
          }
