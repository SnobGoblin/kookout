    "Only good on days off: weekends and public holidays. Notifications look %@ ahead (set in Settings).": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare bra på fridager: helger og helligdager. Varsler ser %@ fremover (velges i Innstillinger)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara bra på lediga dagar: helger och helgdagar. Notiser ser %@ framåt (väljs i Inställningar)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun godt på fridage: weekender og helligdage. Notifikationer ser %@ frem (vælges i Indstillinger)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur an freien Tagen gut: Wochenenden und Feiertage. Mitteilungen schauen %@ voraus (in den Einstellungen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon seulement les jours de repos : week-ends et jours fériés. Les notifications regardent %@ à l'avance (dans les Réglages)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo bueno en días libres: fines de semana y festivos. Las notificaciones miran %@ por delante (en Ajustes)."
          }
        }
      }
    },
