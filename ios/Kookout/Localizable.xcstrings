    "There's already a %@ spot %@ away. Following it keeps riders and fixes in one place.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finnes allerede en %1$@-spot %2$@ unna. Følger du den, samles utøvere og rettelser på ett sted."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns redan en %1$@-spot %2$@ bort. Följer du den samlas åkare och rättelser på ett ställe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er allerede et %1$@-spot %2$@ væk. Følger du det, samles udøvere og rettelser ét sted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt schon einen %1$@-Spot %2$@ entfernt. Folgst du ihm, bleiben Rider und Korrekturen an einem Ort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a déjà un spot de %1$@ à %2$@. Le suivre garde les riders et les corrections au même endroit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay un spot de %1$@ a %2$@. Seguirlo mantiene a los riders y las correcciones en un solo lugar."
          }
        }
      }
    },
    "This iPhone hasn't given Kookout a notification address yet. Check that notifications are allowed, then open Kookout again.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPhonen har ikke gitt Kookout en varslingsadresse ennå. Sjekk at varsler er tillatt, og åpne Kookout på nytt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här iPhonen har inte gett Kookout någon notisadress än. Kontrollera att notiser är tillåtna och öppna Kookout igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPhone har ikke givet Kookout en notifikationsadresse endnu. Tjek, at notifikationer er tilladt, og åbn Kookout igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone hat Kookout noch keine Mitteilungsadresse gegeben. Prüfe, ob Mitteilungen erlaubt sind, und öffne Kookout erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone n'a pas encore donné d'adresse de notification à Kookout. Vérifiez que les notifications sont autorisées, puis rouvrez Kookout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone aún no ha dado a Kookout una dirección de notificaciones. Comprueba que estén permitidas y vuelve a abrir Kookout."
          }
        }
      }
    },
    "This spot will be shared with other Kookout users. Change it under Edit, or for new spots in Settings.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne spoten deles med andre Kookout-brukere. Endre det under Rediger, eller for nye spoter i Innstillinger."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här spoten delas med andra Kookout-användare. Ändra det under Redigera, eller för nya spots i Inställningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette spot deles med andre Kookout-brugere. Ændr det under Rediger, eller for nye spots i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Spot wird mit anderen Kookout-Nutzern geteilt. Ändere das unter Bearbeiten oder für neue Spots in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce spot sera partagé avec les autres utilisateurs de Kookout. Modifiez cela sous Modifier, ou pour les nouveaux spots dans les Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este spot se compartirá con otros usuarios de Kookout. Cámbialo en Editar, o para spots nuevos en Ajustes."
          }
        }
      }
    },
    "To change spots for everyone, sign in with Apple in Settings.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å endre spoter for alle, logg inn med Apple i Innstillinger."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in med Apple i Inställningar för att ändra spots för alla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind med Apple i Indstillinger for at ændre spots for alle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich in den Einstellungen mit Apple an, um Spots für alle zu ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour modifier les spots pour tous, connectez-vous avec Apple dans les Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cambiar spots para todos, inicia sesión con Apple en Ajustes."
          }
        }
      }
    },
    "To fix the name or position for everyone, sign in with Apple in Settings.": {
      "localizations": {
