    "Changes to the name or position are for everyone who follows this spot, and show your name in its history.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringer av navn eller posisjon gjelder alle som følger spoten, og viser navnet ditt i historikken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringar av namn eller position gäller alla som följer spoten och visar ditt namn i historiken."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændringer af navn eller position gælder alle, der følger spottet, og viser dit navn i historikken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen an Name oder Position gelten für alle, die diesem Spot folgen, und zeigen deinen Namen im Verlauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications du nom ou de la position s'appliquent à tous ceux qui suivent ce spot et affichent votre nom dans l'historique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de nombre o posición son para todos los que siguen este spot y muestran tu nombre en el historial."
          }
        }
      }
    },
