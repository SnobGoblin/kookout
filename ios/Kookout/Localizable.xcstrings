    "Start with popular spots near you, or add your own.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynn med populære spoter nær deg, eller legg til dine egne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja med populära spots nära dig, eller lägg till dina egna."
          }
