    "For example offshore wind. Tap to choose.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For eksempel fralandsvind. Trykk for å velge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Till exempel frånlandsvind. Tryck för att välja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For eksempel fralandsvind. Tryk for at vælge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Beispiel ablandiger Wind. Zum Auswählen tippen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par exemple vent offshore. Touchez pour choisir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ejemplo viento terral. Toca para elegir."
          }
        }
      }
    },
