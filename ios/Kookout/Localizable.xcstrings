          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Kookout-Nutzer finden diesen Spot auf der Karte: Name, Ort, Regeln und dein Name."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres utilisateurs de Kookout peuvent trouver ce spot sur la carte : nom, lieu, règles et votre nom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros usuarios de Kookout pueden encontrar este spot en el mapa: nombre, lugar, reglas y tu nombre."
          }
        }
      }
    },
    "Others can then find them on the map, with their name, place and rules. Spots you keep private stay on your phone, and you can change this for each spot under Edit.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Da kan andre finne dem på kartet, med navn, sted og regler. Spoter du holder private, blir på telefonen din, og du kan endre dette for hver spot under Rediger."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Då kan andra hitta dem på kartan, med namn, plats och regler. Spots du håller privata stannar på din telefon, och du kan ändra det för varje spot under Redigera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Så kan andre finde dem på kortet, med navn, sted og regler. Spots, du holder private, bliver på din telefon, og du kan ændre det for hvert spot under Rediger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dann finden andere sie auf der Karte, mit Name, Ort und Regeln. Private Spots bleiben auf deinem Telefon; du kannst das für jeden Spot unter Bearbeiten ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres pourront alors les trouver sur la carte, avec leur nom, leur lieu et leurs règles. Les spots privés restent sur votre téléphone, et vous pouvez changer cela pour chaque spot sous Modifier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así otros podrán encontrarlos en el mapa, con su nombre, lugar y reglas. Los spots privados se quedan en tu teléfono, y puedes cambiarlo para cada spot en Editar."
          }
        }
      }
    },
