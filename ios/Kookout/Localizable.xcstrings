            "value": "Till exempel där du bor, för att se de populära spotsen där."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For eksempel hvor du bor, for at se de populære spots der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Beispiel, wo du wohnst, um die beliebten Spots dort zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par exemple là où vous habitez, pour voir les spots populaires du coin."
          }
        },
        "es": {
