    "Other Kookout users can find this spot on the map: its name, place and rules, and your name from Settings if you've set one.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Andre Kookout-brukere kan finne denne spoten på kartet: navn, sted og regler, og navnet ditt fra Innstillinger hvis du har skrevet det inn."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Andra Kookout-användare kan hitta den här spoten på kartan: namn, plats och regler, och ditt namn från Inställningar om du har angett det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Andre Kookout-brugere kan finde dette spot på kortet: navn, sted og regler, og dit navn fra Indstillinger, hvis du har skrevet det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Kookout-Nutzer finden diesen Spot auf der Karte: Name, Ort und Regeln, und deinen Namen aus den Einstellungen, falls angegeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres utilisateurs de Kookout peuvent trouver ce spot sur la carte : son nom, son lieu et ses règles, et votre nom des Réglages si vous l'avez indiqué."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros usuarios de Kookout pueden encontrar este spot en el mapa: su nombre, lugar y reglas, y tu nombre de Ajustes si lo has puesto."
          }
        }
      }
    },
