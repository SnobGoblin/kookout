    "Couldn't reach Kookout. Check the internet connection.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fikk ikke kontakt med Kookout. Sjekk internettforbindelsen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte nå Kookout. Kontrollera internetanslutningen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke få kontakt med Kookout. Tjek internetforbindelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kookout ist nicht erreichbar. Prüfe die Internetverbindung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre Kookout. Vérifiez la connexion Internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con Kookout. Comprueba la conexión a internet."
          }
        }
      }
    },
