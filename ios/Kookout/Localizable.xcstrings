    "This iPhone hasn't given Kookout a notification address yet. Check that notifications are allowed, then open Kookout again.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPhonen har ikke gitt Kookout en varslingsadresse ennå. Sjekk at varsler er tillatt, og åpne Kookout på nytt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här iPhonen har inte gett Kookout någon notisadress än. Kontrollera att notiser är tillåtna och öppna Kookout igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPhone har ikke givet Kookout en notifikationsadresse endnu. Tjek, at notifikationer er tilladt, og åbn Kookout igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone hat Kookout noch keine Mitteilungsadresse gegeben. Prüfe, ob Mitteilungen erlaubt sind, und öffne Kookout erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone n'a pas encore donné d'adresse de notification à Kookout. Vérifiez que les notifications sont autorisées, puis rouvrez Kookout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone aún no ha dado a Kookout una dirección de notificaciones. Comprueba que estén permitidas y vuelve a abrir Kookout."
          }
        }
      }
    },
