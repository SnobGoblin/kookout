    "When good conditions come up in the next %@, or change. How far ahead is set in Settings.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når gode forhold dukker opp de neste %@, eller endrer seg. Hvor langt frem velges i Innstillinger."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När bra förhållanden dyker upp de närmaste %@, eller ändras. Hur långt fram väljs i Inställningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når gode forhold dukker op inden for de næste %@, eller ændrer sig. Hvor langt frem vælges i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn in den nächsten %@ gute Bedingungen kommen oder sich ändern. Wie weit voraus, legst du in den Einstellungen fest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand de bonnes conditions arrivent dans un délai de %@, ou changent. Le délai se règle dans les Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando lleguen buenas condiciones en un plazo de %@, o cambien. El plazo se elige en Ajustes."
          }
        }
      }
    },
