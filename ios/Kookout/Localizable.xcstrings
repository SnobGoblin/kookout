    "You're signed out, so this spot isn't updated for others. Switch it off to stop sharing it, or sign in with Apple in Settings.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er logget ut, så spoten oppdateres ikke for andre. Slå av for å slutte å dele den, eller logg inn med Apple i Innstillinger."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är utloggad, så spoten uppdateras inte för andra. Stäng av för att sluta dela den, eller logga in med Apple i Inställningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er logget ud, så spottet opdateres ikke for andre. Slå fra for at stoppe med at dele det, eller log ind med Apple i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist abgemeldet, daher wird dieser Spot für andere nicht aktualisiert. Schalte ihn aus, um ihn nicht mehr zu teilen, oder melde dich in den Einstellungen mit Apple an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes déconnecté, ce spot n'est donc pas mis à jour pour les autres. Désactivez-le pour arrêter de le partager, ou connectez-vous avec Apple dans les Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has cerrado sesión, así que este spot no se actualiza para otros. Desactívalo para dejar de compartirlo o inicia sesión con Apple en Ajustes."
          }
        }
      }
    },
    "Your name": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet ditt"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt namn"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit navn"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Name"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nom"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre"
          }
        }
      }
    },
    "Your spots stay on this phone. Spots you shared stay for the people who use them, without your name.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotene dine blir på denne telefonen. Spoter du har delt, blir værende for dem som bruker dem, uten navnet ditt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina spots stannar på den här telefonen. Spots du har delat finns kvar för dem som använder dem, utan ditt namn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine spots bliver på denne telefon. Spots, du har delt, bliver for dem, der bruger dem, uden dit navn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Spots bleiben auf diesem Telefon. Geteilte Spots bleiben für alle, die sie nutzen, ohne deinen Namen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos spots restent sur ce téléphone. Les spots partagés restent pour ceux qui les utilisent, sans votre nom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus spots se quedan en este teléfono. Los spots que compartiste siguen para quienes los usan, sin tu nombre."
          }
        }
      }
    },
