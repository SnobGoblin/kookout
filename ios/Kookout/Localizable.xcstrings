    "Sharing needs Sign in with Apple, so changes to spots show who made them. Kookout gets your name, not your email.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Deling krever innlogging med Apple, så endringer på spoter viser hvem som gjorde dem. Kookout får navnet ditt, ikke e-postadressen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Delning kräver inloggning med Apple, så att ändringar av spots visar vem som gjorde dem. Kookout får ditt namn, inte din e-post."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deling kræver log ind med Apple, så ændringer af spots viser, hvem der lavede dem. Kookout får dit navn, ikke din e-mail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Teilen brauchst du die Anmeldung mit Apple, damit Änderungen zeigen, wer sie gemacht hat. Kookout bekommt deinen Namen, nicht deine E-Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage nécessite de se connecter avec Apple, pour que les modifications indiquent qui les a faites. Kookout reçoit votre nom, pas votre e-mail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir requiere iniciar sesión con Apple, para que los cambios muestren quién los hizo. Kookout recibe tu nombre, no tu correo."
          }
        }
      }
    },
    "Shown as “Added by …” on the spots you share, and next to changes you make.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises som «Lagt til av …» på spotene du deler, og ved endringer du gjør."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas som ”Tillagd av …” på spots du delar, och vid ändringar du gör."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises som »Tilføjet af …« på de spots, du deler, og ved ændringer, du laver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird als „Hinzugefügt von …“ bei deinen geteilten Spots und bei deinen Änderungen angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiché comme « Ajouté par … » sur les spots que vous partagez, et à côté de vos modifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra como «Añadido por …» en los spots que compartes y junto a tus cambios."
          }
        }
      }
    },
    "Sign in with Apple to share spots and edit spots others share. Kookout gets your name, not your email. Everything else works without an account.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn med Apple for å dele spoter og endre spoter andre deler. Kookout får navnet ditt, ikke e-postadressen. Alt annet virker uten konto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in med Apple för att dela spots och ändra spots som andra delar. Kookout får ditt namn, inte din e-post. Allt annat fungerar utan konto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind med Apple for at dele spots og ændre spots, andre deler. Kookout får dit navn, ikke din e-mail. Alt andet virker uden konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit Apple an, um Spots zu teilen und geteilte Spots zu bearbeiten. Kookout bekommt deinen Namen, nicht deine E-Mail. Alles andere geht ohne Konto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec Apple pour partager des spots et modifier ceux des autres. Kookout reçoit votre nom, pas votre e-mail. Tout le reste fonctionne sans compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con Apple para compartir spots y editar los de otros. Kookout recibe tu nombre, no tu correo. Todo lo demás funciona sin cuenta."
          }
        }
      }
    },
