    "Followed by %lld riders. The community's rules are the majority's; yours are your own.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fulgt av %lld utøvere. Fellesskapets regler er flertallets; dine er dine egne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följs av %lld åkare. Gemenskapens regler är majoritetens; dina är dina egna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fulgt af %lld udøvere. Fællesskabets regler er flertallets; dine er dine egne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Rider folgen diesem Spot. Die Regeln der Community sind die der Mehrheit; deine gehören dir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivi par %lld riders. Les règles de la communauté sont celles de la majorité ; les vôtres sont à vous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguido por %lld riders. Las reglas de la comunidad son las de la mayoría; las tuyas son tuyas."
          }
        }
      }
    },
    "For example offshore wind. Tap to choose.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For eksempel fralandsvind. Tryk for at vælge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Beispiel ablandiger Wind. Zum Auswählen tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ejemplo viento terral. Toca para elegir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par exemple vent offshore. Touchez pour choisir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For eksempel fralandsvind. Trykk for å velge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Till exempel frånlandsvind. Tryck för att välja."
          }
        }
      }
    },
    "For example where you live, to see the popular spots there.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For eksempel der du bor, for å se de populære spotene der."
          }
        },
        "sv": {
