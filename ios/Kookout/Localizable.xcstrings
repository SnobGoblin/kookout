    "Away from home? Look for the spots where you usually ride.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Borte fra hjemme? Finn spotene der du pleier å kjøre."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Borta hemifrån? Leta upp spotsen där du brukar åka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Væk hjemmefra? Find de spots, hvor du plejer at køre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht zu Hause? Such die Spots, an denen du sonst fährst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loin de chez vous ? Cherchez les spots où vous ridez d'habitude."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Fuera de casa? Busca los spots donde sueles ir."
          }
        }
      }
    },
    "Be the first: add your own spot on the map. Or look near another place, like home.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bli den første: legg til din egen spot på kartet. Eller se et annet sted, for eksempel hjemme."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bli först: lägg till din egen spot på kartan. Eller titta på en annan plats, till exempel hemma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vær den første: tilføj dit eget spot på kortet. Eller kig et andet sted, for eksempel derhjemme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei der Erste: Füge deinen eigenen Spot auf der Karte hinzu. Oder schau an einem anderen Ort, zum Beispiel zu Hause."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez le premier : ajoutez votre propre spot sur la carte. Ou regardez ailleurs, chez vous par exemple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero: añade tu propio spot en el mapa. O mira en otro lugar, como tu casa."
          }
        }
      }
    },
