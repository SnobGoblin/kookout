    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kookout bruker posisjonen din for å finne spoter nær deg og vise hvor du er på kartet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kookout använder din plats för att hitta spots nära dig och visa var du är på kartan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kookout bruger din placering til at finde spots nær dig og vise, hvor du er på kortet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kookout verwendet deinen Standort, um Spots in deiner Nähe zu finden und zu zeigen, wo du auf der Karte bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kookout utilise votre position pour trouver des spots près de vous et vous situer sur la carte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kookout usa tu ubicación para encontrar spots cerca de ti y mostrar dónde estás en el mapa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kookout uses your location to find spots near you and to show where you are on the map."
          }
        }
      }
    }
  },
  "version": "1.0"
}